<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_picker_preview_background"
    tools:layout_width="180dp"
    tools:layout_height="110dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_sensor_name"
            android:textColor="@color/widget_preview_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/simplePreviewValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="21.5"
                android:textColor="@color/widget_preview_value"
                android:textSize="22sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@id/simplePreviewValue"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@id/simplePreviewValue"
                android:ellipsize="end"
                android:fontFamily="@font/oswald_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/temperature_celsius_unit"
                android:textColor="@color/widget_preview_secondary"
                android:textSize="10sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/temperature"
            android:textColor="@color/widget_preview_secondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:paddingEnd="44dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="12:34"
            android:textColor="@color/widget_preview_secondary"
            android:textSize="9sp"
            tools:ignore="HardcodedText,RtlSymmetry,SmallSp" />
    </LinearLayout>

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|bottom"
        android:contentDescription="@null"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:src="@drawable/ic_widget_d_update"
        android:tint="@color/widget_preview_secondary"
        tools:ignore="UseAppTint" />

</FrameLayout>
