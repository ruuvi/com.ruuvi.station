<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis triggers onUpdate, which delegates refresh to one-time WorkManager work. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="45dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:previewImage="@drawable/simple_widget_preview_legacy"
    android:previewLayout="@layout/simple_widget_picker_preview"
    android:initialLayout="@layout/widget_simple_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.ruuvi.station.widgets.ui.simpleWidget.SimpleWidgetConfigureActivity"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:widgetFeatures="reconfigurable"
    android:initialKeyguardLayout="@layout/widget_simple_preview"
/>
